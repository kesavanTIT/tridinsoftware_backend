// Prisma Schema file for Tridin Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String   @default("Admin User")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  service   String
  message   String
  status    String   @default("NEW") // NEW, IN_REVIEW, RESPONDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApplication {
  id              String   @id @default(uuid())
  roleTitle       String
  department      String
  applicantName   String
  applicantEmail  String
  applicantPhone  String
  experience      String   @default("Fresher (0-1 Yrs)")
  qualification   String?  @default("B.E / B.Tech")
  noticePeriod    String?  @default("Immediate Joiner")
  currentLocation String?  @default("Chennai")
  relocateConsent String?  @default("Yes")
  keySkills       String?  @default("")
  expectedSalary  String?  @default("As per company norms")
  portfolioUrl    String
  resumeUrl       String?  @default("")
  resumeBase64    String?  @default("")
  coverNote       String?
  status          String   @default("SUBMITTED") // SUBMITTED, SHORTLISTED, REJECTED, INTERVIEWING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id           String   @id @default(uuid())
  title        String
  department   String
  location     String   @default("Chennai, India")
  type         String   @default("Full-Time")
  experience   String   @default("0-3 Years")
  vacancies    Int      @default(10)
  badge        String   @default("Hiring")
  description  String
  curriculum   String[] @default([])
  requirements String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Brand New Employee Document Onboarding Models
model OnboardingCandidate {
  id                    String               @id @default(uuid())
  onboardingId          String               @unique // e.g. TD2201
  fullName              String
  email                 String               @unique
  password              String               @default("Tridin@2026")
  phone                 String               @default("")
  role                  String               @default("Software Engineer")
  department            String               @default("Engineering")
  joiningDate           String?
  dob                   String?
  gender                String?              @default("Male")
  bloodGroup            String?              @default("O+")
  currentAddress        String?
  permanentAddress      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bankName              String?
  accountNumber         String?
  ifscCode              String?
  panNumber             String?              @default("")
  aadharNumber          String?              @default("")
  status                String               @default("Pending") // Pending, Verified, Action Required
  documents             OnboardingDocument[]
  assetAssignments      AssetAssignment[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model OnboardingDocument {
  id          String              @id @default(uuid())
  category    String              // Identity, Tenth, Twelfth, Education, Experience, Banking, Personal
  type        String              // Aadhar Card, PAN Card, Degree Certificate, etc.
  name        String              // File name
  size        String?             // File size string e.g. 1.2 MB
  fileUrl     String?             // Path or URL to file
  fileBase64  String?             // Optional base64 or fallback
  status      String              @default("Pending") // Pending, Approved, Rejected
  remark      String?             // HR rejection remark if any
  candidateId String
  candidate   OnboardingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// ─── Asset Management Models ───────────────────────────────────────────────

model Asset {
  id             String            @id @default(uuid())
  assetId        String            @unique // e.g. AST-LAP-0001
  assetName      String            // e.g. Dell Latitude 5420
  assetType      String            // Laptop, Bag, Charger, Mouse, Monitor, Other
  assetCategory  String            @default("IT Equipment") // IT Equipment, Furniture, etc.
  brand          String?           @default("")
  model          String?           @default("")
  modelNumber    String?           @default("")
  serialNumber   String?           @default("") // Physical serial number on device
  processor      String?           @default("")
  ram            String?           @default("")
  storage        String?           @default("")
  assetTag       String?           @default("") // Sticker tag e.g. TRD-LAP-001
  status         String            @default("Available") // Available, Assigned, In Repair, Retired
  condition      String            @default("Good") // Good, Fair, Damaged
  purchaseDate   String?
  warrantyExpiry String?
  notes          String?
  assignments    AssetAssignment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AssetAssignment {
  id           String              @id @default(uuid())
  assetId      String
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    OnboardingCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedDate String              // Date of issue e.g. 2026-10-09
  returnDate   String?             // Date of return, null if not returned
  assignedBy   String              @default("Admin")
  remarks      String?             // e.g. Issued on Day 1 joining
  status       String              @default("Issued") // Issued, Returned
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}
